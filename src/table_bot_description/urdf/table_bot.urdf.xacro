<?xml version="1.0"?>
<robot name="table_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:property name="base_length" value="0.6"/>
<xacro:property name="base_width"  value="0.4"/>
<xacro:property name="base_height" value="0.02"/>
<xacro:property name="leg_height"  value="0.21"/>
<xacro:property name="wheel_radius" value="0.05"/>
<xacro:property name="wheel_width"  value="0.04"/>
<xacro:property name="wheel_xoff" value="0.25"/>
<xacro:property name="wheel_yoff" value="0.18"/>

<xacro:property name="lidar_radius" value="0.035"/>
<xacro:property name="lidar_height" value="0.04"/>

<material name="wood"><color rgba="0.76 0.6 0.42 1"/></material>
<material name="black"><color rgba="0.05 0.05 0.05 1"/></material>
<material name="grey"><color rgba="0.3 0.3 0.3 1"/></material>
<material name="dark_grey"><color rgba="0.2 0.2 0.2 1"/></material>

<link name="base_link"/>

<link name="chassis">
<visual>
<geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
<material name="wood"/>
</visual>
<collision>
<geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
</collision>
<inertial>
<mass value="3.0"/>
<inertia ixx="0.05" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.1"/>
</inertial>
</link>

<joint name="chassis_joint" type="fixed">
<parent link="base_link"/>
<child link="chassis"/>
<origin xyz="0 0 ${leg_height + wheel_radius}"/>
</joint>

<xacro:macro name="leg_wheel" params="prefix x_pos y_pos">

<link name="${prefix}_leg">
<visual>
<geometry><cylinder radius="0.01" length="${leg_height}"/></geometry>
<material name="grey"/>
</visual>
<collision>
<geometry><cylinder radius="0.01" length="${leg_height}"/></geometry>
</collision>
<inertial>
<mass value="0.2"/>
<inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0001"/>
</inertial>
</link>

<joint name="${prefix}_leg_joint" type="fixed">
<parent link="chassis"/>
<child link="${prefix}_leg"/>
<origin xyz="${x_pos} ${y_pos} ${-(leg_height/2 + base_height/2)}"/>
</joint>

<link name="${prefix}_wheel">
<visual>
<geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
<origin rpy="1.5708 0 0"/>
<material name="black"/>
</visual>
<collision>
<geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
<origin rpy="1.5708 0 0"/>
</collision>
<inertial>
<mass value="0.4"/>
<inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
</inertial>
</link>

<joint name="${prefix}_wheel_joint" type="continuous">
<parent link="${prefix}_leg"/>
<child link="${prefix}_wheel"/>
<origin xyz="0 0 ${-leg_height/2}"/>
<axis xyz="0 1 0"/>
</joint>

</xacro:macro>

<xacro:leg_wheel prefix="front_left"  x_pos="${wheel_xoff}"  y_pos="${wheel_yoff}"/>
<xacro:leg_wheel prefix="front_right" x_pos="${wheel_xoff}"  y_pos="${-wheel_yoff}"/>
<xacro:leg_wheel prefix="rear_left"   x_pos="${-wheel_xoff}" y_pos="${wheel_yoff}"/>
<xacro:leg_wheel prefix="rear_right"  x_pos="${-wheel_xoff}" y_pos="${-wheel_yoff}"/>

<!-- Giam ma sat banh xe: xe skid-steer 4 banh co dinh can truot ngang duoc
     moi xoay tai cho, mac dinh Gazebo ma sat qua cao khien xe rung/nhun ma
     khong xoay. Giam mu/mu2 cho ca 4 banh. -->
<xacro:macro name="wheel_friction" params="link_name">
  <gazebo reference="${link_name}">
    <mu1>0.5</mu1>
    <mu2>0.3</mu2>
  </gazebo>
</xacro:macro>

<xacro:wheel_friction link_name="front_left_wheel"/>
<xacro:wheel_friction link_name="front_right_wheel"/>
<xacro:wheel_friction link_name="rear_left_wheel"/>
<xacro:wheel_friction link_name="rear_right_wheel"/>

<!-- ==================== LIDAR 2D (gan tren mat ban) ==================== -->
<joint name="lidar_joint" type="fixed">
<parent link="chassis"/>
<child link="lidar_link"/>
<origin xyz="0 0 0.16"/>
</joint>

<link name="lidar_link">
<visual>
<geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
<material name="dark_grey"/>
</visual>
<collision>
<geometry><cylinder radius="${lidar_radius}" length="${lidar_height}"/></geometry>
</collision>
<inertial>
<mass value="0.15"/>
<inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
</inertial>
</link>

<!-- ==================== IMU (gan tai base_link, translation=0) ====================
     Luu y: Cartographer yeu cau IMU frame phai trung goc voi tracking_frame
     ("base_link" trong lua config) - CHECK(sensor_to_tracking->translation()
     .norm() < 1e-5) trong SensorBridge::ToImuData(). Neu gan len chassis (co
     offset theo z) no se crash ngay khi nhan message IMU dau tien. -->
<joint name="imu_joint" type="fixed">
<parent link="base_link"/>
<child link="imu_link"/>
<origin xyz="0 0 0"/>
</joint>

<link name="imu_link">
<visual>
<geometry><box size="0.02 0.02 0.01"/></geometry>
<material name="black"/>
</visual>
<collision>
<geometry><box size="0.02 0.02 0.01"/></geometry>
</collision>
<inertial>
<mass value="0.02"/>
<inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
</inertial>
</link>

<xacro:include filename="$(find table_bot_description)/urdf/table_bot.gazebo.xacro"/>

</robot>
